# Copy to .env.local for local development. Never commit real values.

# Public base URL of the RightProperty365 Go API. Browsers call it for sign-in,
# enquiries and the inbox, so it is compiled into the client bundle.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Address the web SERVER uses to read listings, directory and reference data
# from the API, for example a cluster-internal address. Read at run time and
# never sent to browsers. Optional: defaults to NEXT_PUBLIC_API_URL.
# API_URL=http://api.internal:8080

# Public origin of this site (used for canonical URLs and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to make `next build` skip the API even when one is reachable, so
# no API data is stored in the build. Pages then read the API on each request.
# Not needed in CI: a build that cannot reach the API does this by itself.
# BUILD_WITHOUT_API=1

# Turns on POST /api/revalidate (on-demand cache revalidation) and is the bearer
# token it requires. Server only. Leave unset to keep the route off.
# REVALIDATE_SECRET=

# Mobile app links (BR-016). Read at run time, server only. While a value is
# unset or invalid its file answers 404 and the site claims nothing for the app.
# Android: comma-separated SHA-256 signing certificate fingerprints, as
# AB:CD:... (32 colon-separated hex bytes), for /.well-known/assetlinks.json.
# ANDROID_APP_SHA256_FINGERPRINTS=
# ANDROID_APP_PACKAGE=com.rightproperty365.rightproperty365
# iOS: the 10-character Apple Developer Team ID, for
# /.well-known/apple-app-site-association.
# APPLE_TEAM_ID=
# IOS_BUNDLE_ID=com.rightproperty365.rightproperty365

# Shows the "This is a test site" banner and tells search engines not to index
# the site. By default it is on when NEXT_PUBLIC_SITE_URL starts with
# "staging."; set 1 or 0 to decide explicitly. Compiled in at build time.
# NEXT_PUBLIC_TEST_SITE=1

# Map tiles (Leaflet raster tiles, https only) and the credit the provider
# requires. Compiled in at build time. Unset: OpenStreetMap's public tiles in
# development and on a test site, and no map at all on a production site.
# Production needs a paid or self-hosted tile source.
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; Example Maps
