{
  "$description": "RightProperty365 design tokens. Single source of truth. Run `npm run tokens` to regenerate tokens.css. Brand colours come from the approved logo kit v4.1 (design/assets/logo): indigo #1900AC, turquoise #21DDBA, white.",
  "palette": {
    "white": "#ffffff",
    "slate": {
      "25": "#f8f9fc",
      "50": "#f1f3f8",
      "100": "#e6e9f0",
      "200": "#d5dae4",
      "300": "#bcc3d1",
      "400": "#98a1b3",
      "450": "#7c8598",
      "500": "#626b7e",
      "600": "#4f586a",
      "700": "#3a4252",
      "800": "#252b38",
      "850": "#1b202b",
      "900": "#131722",
      "950": "#0c0f17"
    },
    "indigo": {
      "50": "#f1efff",
      "100": "#e2deff",
      "200": "#c5bdff",
      "300": "#a093ff",
      "400": "#7a66ff",
      "500": "#4a2fe0",
      "600": "#1900ac",
      "700": "#14008a",
      "800": "#0f0069",
      "900": "#0a0047"
    },
    "turquoise": {
      "50": "#e9fcf8",
      "100": "#c8f7ed",
      "300": "#6eead3",
      "500": "#21ddba",
      "600": "#12b396",
      "700": "#0a6f5d",
      "900": "#0a3a32"
    }
  },
  "font": {
    "family": {
      "display": "var(--font-inter), 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "sans": "var(--font-inter), 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "var(--font-geist-mono), ui-monospace, 'SFMono-Regular', Consolas, monospace"
    }
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "full": "999px"
  },
  "shadow": {
    "xs": "0 1px 2px rgb(19 23 34 / 0.06)",
    "sm": "0 1px 2px rgb(19 23 34 / 0.05), 0 2px 6px rgb(19 23 34 / 0.05)",
    "md": "0 2px 4px rgb(19 23 34 / 0.04), 0 8px 24px rgb(19 23 34 / 0.08)",
    "lg": "0 4px 8px rgb(19 23 34 / 0.04), 0 20px 48px rgb(19 23 34 / 0.14)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "theme": {
    "light": {
      "color": {
        "bg": {
          "page": "{palette.slate.25}",
          "surface": "{palette.white}",
          "sunken": "{palette.slate.50}",
          "inverse": "{palette.slate.900}"
        },
        "text": {
          "ink": "{palette.slate.900}",
          "muted": "{palette.slate.600}",
          "subtle": "{palette.slate.500}",
          "inverse": "{palette.slate.25}"
        },
        "border": {
          "line": "{palette.slate.200}",
          "strong": "{palette.slate.300}",
          "control": "{palette.slate.450}"
        },
        "brand": {
          "base": "{palette.indigo.600}",
          "deep": "{palette.indigo.800}",
          "on": "{palette.white}",
          "accent": "{palette.turquoise.500}",
          "logo": "{palette.indigo.600}"
        },
        "primary": {
          "base": "{palette.indigo.600}",
          "hover": "{palette.indigo.700}",
          "soft": "{palette.indigo.50}",
          "ink": "{palette.indigo.600}",
          "on": "{palette.white}"
        },
        "accent": {
          "base": "{palette.turquoise.500}",
          "soft": "{palette.turquoise.50}",
          "ink": "{palette.turquoise.700}"
        },
        "success": { "base": "#276f45", "soft": "#e8f3ec" },
        "warning": { "base": "#8a5208", "soft": "#fbf1df" },
        "danger": { "base": "#b3372f", "soft": "#fbebe9" },
        "info": { "base": "#2b5f8a", "soft": "#e8f0f7" },
        "focus": "{palette.indigo.500}",
        "overlay": "rgb(19 23 34 / 0.5)"
      }
    },
    "dark": {
      "color": {
        "bg": {
          "page": "{palette.slate.900}",
          "surface": "{palette.slate.850}",
          "sunken": "{palette.slate.950}",
          "inverse": "{palette.slate.50}"
        },
        "text": {
          "ink": "{palette.slate.50}",
          "muted": "{palette.slate.300}",
          "subtle": "{palette.slate.400}",
          "inverse": "{palette.slate.900}"
        },
        "border": {
          "line": "{palette.slate.800}",
          "strong": "{palette.slate.700}",
          "control": "{palette.slate.450}"
        },
        "brand": {
          "base": "{palette.indigo.600}",
          "deep": "{palette.indigo.800}",
          "on": "{palette.white}",
          "accent": "{palette.turquoise.500}",
          "logo": "{palette.white}"
        },
        "primary": {
          "base": "{palette.indigo.300}",
          "hover": "{palette.indigo.200}",
          "soft": "#1c1650",
          "ink": "{palette.indigo.200}",
          "on": "{palette.indigo.900}"
        },
        "accent": {
          "base": "{palette.turquoise.300}",
          "soft": "{palette.turquoise.900}",
          "ink": "{palette.turquoise.100}"
        },
        "success": { "base": "#7cc79a", "soft": "#17301f" },
        "warning": { "base": "#e8b45c", "soft": "#3a2c10" },
        "danger": { "base": "#f0938b", "soft": "#3d1a17" },
        "info": { "base": "#8db9de", "soft": "#152b3d" },
        "focus": "{palette.indigo.300}",
        "overlay": "rgb(0 0 0 / 0.6)"
      }
    }
  }
}
