{
  "$description": "RightProperty365 design tokens. Single source of truth. Run `npm run tokens` to regenerate tokens.css. Palette is PROVISIONAL until the logo pack is supplied.",
  "palette": {
    "white": "#ffffff",
    "stone": {
      "25": "#faf9f5",
      "50": "#f4f2eb",
      "100": "#eae7dd",
      "200": "#ddd9cc",
      "300": "#c9c4b5",
      "400": "#a29d90",
      "450": "#8c877a",
      "500": "#6f6b61",
      "600": "#5f5b52",
      "700": "#45423b",
      "800": "#2b2925",
      "850": "#211f1c",
      "900": "#191816",
      "950": "#11100f"
    },
    "evergreen": {
      "50": "#eef5f1",
      "100": "#d7e8df",
      "200": "#b0d1c0",
      "300": "#7fb39c",
      "400": "#4f9079",
      "500": "#2f735d",
      "600": "#1f5c49",
      "700": "#18493a",
      "800": "#133a2f",
      "900": "#0e2b23"
    },
    "ochre": {
      "50": "#fbf4e6",
      "100": "#f5e4bf",
      "300": "#e3bc6a",
      "500": "#c48f2b",
      "600": "#a67519",
      "700": "#855c12",
      "900": "#3a2e12"
    }
  },
  "font": {
    "family": {
      "display": "var(--font-fraunces), 'Iowan Old Style', 'Palatino Linotype', Georgia, serif",
      "sans": "var(--font-geist-sans), ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "var(--font-geist-mono), ui-monospace, 'SFMono-Regular', Consolas, monospace"
    }
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "full": "999px"
  },
  "shadow": {
    "xs": "0 1px 2px rgb(25 24 22 / 0.06)",
    "sm": "0 1px 2px rgb(25 24 22 / 0.05), 0 2px 6px rgb(25 24 22 / 0.05)",
    "md": "0 2px 4px rgb(25 24 22 / 0.04), 0 8px 24px rgb(25 24 22 / 0.08)",
    "lg": "0 4px 8px rgb(25 24 22 / 0.04), 0 20px 48px rgb(25 24 22 / 0.12)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "theme": {
    "light": {
      "color": {
        "bg": {
          "page": "{palette.stone.25}",
          "surface": "{palette.white}",
          "sunken": "{palette.stone.50}",
          "inverse": "{palette.stone.900}"
        },
        "text": {
          "ink": "{palette.stone.900}",
          "muted": "{palette.stone.600}",
          "subtle": "{palette.stone.500}",
          "inverse": "{palette.stone.25}"
        },
        "border": {
          "line": "{palette.stone.200}",
          "strong": "{palette.stone.300}",
          "control": "{palette.stone.450}"
        },
        "primary": {
          "base": "{palette.evergreen.600}",
          "hover": "{palette.evergreen.700}",
          "soft": "{palette.evergreen.50}",
          "ink": "{palette.evergreen.700}",
          "on": "{palette.white}"
        },
        "accent": {
          "base": "{palette.ochre.500}",
          "soft": "{palette.ochre.50}",
          "ink": "{palette.ochre.700}"
        },
        "success": { "base": "#276f45", "soft": "#e8f3ec" },
        "warning": { "base": "#8a5208", "soft": "#fbf1df" },
        "danger": { "base": "#b3372f", "soft": "#fbebe9" },
        "info": { "base": "#2b5f8a", "soft": "#e8f0f7" },
        "focus": "{palette.evergreen.500}",
        "overlay": "rgb(25 24 22 / 0.5)"
      }
    },
    "dark": {
      "color": {
        "bg": {
          "page": "{palette.stone.900}",
          "surface": "{palette.stone.850}",
          "sunken": "{palette.stone.950}",
          "inverse": "{palette.stone.50}"
        },
        "text": {
          "ink": "{palette.stone.50}",
          "muted": "{palette.stone.300}",
          "subtle": "{palette.stone.400}",
          "inverse": "{palette.stone.900}"
        },
        "border": {
          "line": "{palette.stone.800}",
          "strong": "{palette.stone.700}",
          "control": "{palette.stone.450}"
        },
        "primary": {
          "base": "{palette.evergreen.300}",
          "hover": "{palette.evergreen.200}",
          "soft": "#18332a",
          "ink": "{palette.evergreen.200}",
          "on": "{palette.evergreen.900}"
        },
        "accent": {
          "base": "{palette.ochre.300}",
          "soft": "{palette.ochre.900}",
          "ink": "{palette.ochre.100}"
        },
        "success": { "base": "#7cc79a", "soft": "#17301f" },
        "warning": { "base": "#e8b45c", "soft": "#3a2c10" },
        "danger": { "base": "#f0938b", "soft": "#3d1a17" },
        "info": { "base": "#8db9de", "soft": "#152b3d" },
        "focus": "{palette.evergreen.300}",
        "overlay": "rgb(0 0 0 / 0.6)"
      }
    }
  }
}
